# Copy to backend/.env for local use; SETUP.md walks through every value.
# In production, set these in your host's environment settings instead.
# After editing, run: npm run check

# --- Supabase ---------------------------------------------------------------
# Supabase -> Connect (top of the dashboard) -> "Transaction pooler". Replace [YOUR-PASSWORD] with
# your database password and keep ?sslmode=require on the end. The API uses this one.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:6543/postgres?sslmode=require
# Same dialog -> "Session pooler" (port 5432). Only `npm run db:migrate` uses it; delete the line to use DATABASE_URL.
MIGRATION_DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Supabase -> Project Settings -> Data API -> Project URL.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Project Settings -> API Keys -> publishable key (sb_publishable_...) or the legacy "anon" key.
# Safe to share: browsers get it so admins can sign in.
SUPABASE_ANON_KEY=
# Project Settings -> API Keys -> secret key (sb_secret_...) or the legacy "service_role" key.
# Full access to everything: server only, used by `npm run create-admin`.
SUPABASE_SERVICE_ROLE_KEY=
# Only if `npm run check` asks for it (projects still on the legacy JWT secret):
# Project Settings -> JWT Keys -> legacy JWT secret.
SUPABASE_JWT_SECRET=
# Admins sign in with their password plus a 6-digit code from an authenticator app on their phone.
# "off" turns the code off (not recommended). Lost the phone? npm run create-admin -- you@example.com --reset-mfa
# ADMIN_MFA=off

# --- Payments (Razorpay) ------------------------------------------------------
# Leave empty and the site keeps "register interest" only. Start with test keys (rzp_test_...).
# Razorpay dashboard (switch to Test Mode) -> Account & Settings -> API Keys -> Generate Test Key.
# It shows the Key Id and the Key Secret once: copy both.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Required in production, optional locally. Razorpay -> Account & Settings -> Webhooks -> Add New Webhook:
# URL https://YOUR-SITE/api/payments/webhook, a secret you make up (put the same one here), and the events
# payment_link.paid, payment_link.expired, payment_link.cancelled and refund.processed.
RAZORPAY_WEBHOOK_SECRET=
# Public address of the site (where checkout.html lives). Used for return links and payment links.
SITE_URL=http://localhost:4000
# How long a booking holds its places while the customer pays (minimum 30).
# BOOKING_HOLD_MINUTES=30
# How long payment links sent from the dashboard stay valid.
# PAYMENT_LINK_DAYS=14
# How often each process checks for unpaid orders whose time ran out.
# RECONCILE_INTERVAL_SECONDS=60

# --- Server -----------------------------------------------------------------
PORT=4000
# NODE_ENV=production
# LOG_LEVEL=info

# Worker processes per machine. On a VM set it to the CPU count; in containers keep 1 and run more containers.
WEB_CONCURRENCY=1
# Database connections per process. Keep WEB_CONCURRENCY x instances x DB_POOL_MAX under your plan's pooler limit.
DB_POOL_MAX=10

# Behind a load balancer or proxy (Render, Railway, Fly, Nginx), set to 1 so rate limits see real visitor IPs.
# TRUST_PROXY=1

# Shared rate-limit counters across instances (e.g. Upstash Redis). Without it each instance counts on its own.
# REDIS_URL=rediss://default:PASSWORD@HOST:6379

# --- Emails to the team ---------------------------------------------------------
# An email when registrations or payments come in (at most one a minute, listing them all).
# resend.com -> sign up with the inbox that should get them -> API Keys -> Create API key.
# RESEND_API_KEY=re_...
# Where they go (comma-separated). Until you verify a domain in Resend, only the Resend account's own email works.
# NOTIFY_EMAIL=you@example.com
# After verifying your domain in Resend:
# NOTIFY_FROM=GROWND <team@yourdomain.in>

# --- Error alerts -------------------------------------------------------------
# sentry.io -> create a Next.js project -> copy the DSN. Errors on the site and in the API are
# reported there, and Sentry emails you. Not secret: browsers get it too.
# NEXT_PUBLIC_SENTRY_DSN=https://...ingest.sentry.io/...

# Only needed if the site or dashboard calls the API from a different origin (no /api proxy).
# CORS_ORIGINS=https://grownd.example,https://www.grownd.example

# How long the public content (prices, dates) is cached in each instance, in seconds.
# CONTENT_CACHE_SECONDS=30

