{
  "name": "grownd",
  "private": true,
  "type": "module",
  "description": "GROWND website, booking API and admin dashboard. This folder is the deployable app (Vercel Root Directory).",
  "workspaces": [
    "backend"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node frontend/build.mjs",
    "check:site": "node frontend/tools/check-site.mjs",
    "dev": "npm run build && npm run dev -w backend",
    "check": "npm run check -w backend",
    "db:migrate": "npm run db:migrate -w backend",
    "create-admin": "npm run create-admin -w backend --"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
